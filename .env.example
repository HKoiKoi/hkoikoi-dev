# shrimp 작업 데이터 저장 경로. 상대경로면 <프로젝트 루트>/shrimp_data/tasks.json,
# 절대경로면 하위에 프로젝트 폴더명이 한 단계 더 붙는다(<DATA_DIR>/<프로젝트명>/tasks.json).
DATA_DIR=shrimp_data
TEMPLATES_USE=ko
ENABLE_GUI=true

# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# 사이트 공개 주소(끝 슬래시 없이). metadataBase·sitemap·robots의 절대 URL 기준이다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 로컬 E2E 전용 관리자 자격 증명 (NEXT_PUBLIC_ 접두사 금지, 커밋 금지)
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
