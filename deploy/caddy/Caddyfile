# 홈 서버 Caddy 설정 템플릿. /opt/homebrew/etc/Caddyfile 에 반영한다.
# 구조: Cloudflare 터널(cloudflared) → Caddy(127.0.0.1:8080) → Next.js(127.0.0.1:3000)
# TLS는 Cloudflare가 종료하므로 Caddy는 평문 HTTP만 받는다(자동 HTTPS 끔).
# 정식 호스트는 apex(hkoikoi.dev)이며, 그 외 호스트(www 등)는 308로 정식 호스트에 리다이렉트한다.
# 임시 호스트 검증(Task 5) 때는 @canonical 의 host 에 임시 호스트를 추가하고, 끝나면 되돌린다.
{
	auto_https off
}

http://:8080 {
	bind 127.0.0.1

	@canonical host hkoikoi.dev
	handle @canonical {
		reverse_proxy 127.0.0.1:3000
	}

	handle {
		redir https://hkoikoi.dev{uri} 308
	}

	# encode는 Suspense 스트리밍 비버퍼링 검증(Task 5) 결과에 따라 결정한다.
	# 검증 전에는 켜지 않는다(Cloudflare가 엣지에서 압축하므로 필수는 아니다).
	# encode zstd gzip
}
